# 프론트엔드 환경변수 예시
#   cp .env.example .env
#
# ⚠️ Vite 는 VITE_ 로 시작하는 값만 브라우저에 노출한다.
#    그 말은 여기 적은 값이 전부 사용자에게 보인다는 뜻이다.
#    카카오 REST 키·JWT 시크릿 같은 비밀은 절대 넣지 않는다 (CLAUDE.md §8).

# mock = MSW 가 가짜 서버로 응답한다 (백엔드 없이 개발 가능)
# real = VITE_API_BASE_URL 의 실제 백엔드로 붙는다
VITE_API_MODE=mock

VITE_API_BASE_URL=http://localhost:8080

# 카카오맵 JavaScript 키. 도메인 제한을 반드시 걸어 둔다.
# 값이 없으면 지도 대신 안내 문구가 나온다 (지도 없이도 나머지 화면은 동작한다)
VITE_KAKAO_JS_KEY=
