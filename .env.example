# ─────────────────────────────────────────────────────────────
# 가치가(WE-Meet) 환경변수 예시 파일
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# ⚠️ .env 는 절대 커밋하지 않는다 (.gitignore 에 등록돼 있음).
# ⚠️ 이 파일에는 실제 키 값을 적지 않는다. placeholder 만 둔다.
#    실제 키는 팀 단톡방이 아니라 별도 채널로 받는다. (PRD §13.7)
#
# 아래 DB/Redis 기본값은 docker-compose.yml 및
# backend/src/main/resources/application-local.yml 의 기본값과 같다.
# 그대로 두면 .env 없이도 로컬 개발이 된다.
#
# ⚠️ 값에 $ 가 들어가면 $$ 로 쓴다. compose 가 $abc 를 변수로 바꿔 버린다 (경고만 내고 빈 값으로).
#
# ⚠️ .env 를 읽는 것은 docker compose 뿐이다. ./gradlew bootRun 은 읽지 않는다.
#    DB_* / REDIS_* 값을 바꾸면 컨테이너만 바뀌고 백엔드는 기본값으로 붙어 연결이 깨진다.
#    바꿔야 한다면 같은 값을 셸에도 export 하거나 application-local.yml 을 함께 고친다.
# ─────────────────────────────────────────────────────────────

# ── MySQL (로컬 개발 전용 값. 운영 비밀번호를 여기에 적지 않는다) ──
# ⚠️ 베타 배포(docker-compose.prod.yml)에서는 아래 gachiga·root 를 반드시 바꾼다. compose 는 빈 값만 거절하고
#    예시값은 거절하지 못한다.
# 'localhost' 가 아니라 127.0.0.1 이다 — macOS 에서 localhost 는 IPv6(::1) 로 먼저 해석되는데
# 컨테이너는 IPv4 127.0.0.1 에만 열려 있어 연결이 실패한다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gachiga
DB_USERNAME=gachiga
DB_PASSWORD=gachiga
# 컨테이너 root 비밀번호. 로컬 전용이며 애플리케이션은 사용하지 않는다
MYSQL_ROOT_PASSWORD=root

# ── Redis ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 로컬 Redis 는 비밀번호 없이 뜬다. 운영 프로파일에서는 필수 항목이다
REDIS_PASSWORD=

# ── 카카오 (백엔드 전용. 프론트 코드에 절대 노출 금지 — CLAUDE.md §8) ──
# 카카오모빌리티 길찾기 / 로컬 API 호출용 REST 키
KAKAO_REST_API_KEY=여기에-발급받은-REST-키를-넣으세요
# 카카오맵 JS SDK 용 JavaScript 키 (프론트에서 사용, 도메인 제한 필수)
KAKAO_JS_KEY=여기에-발급받은-JavaScript-키를-넣으세요

# ── 프론트엔드 환경변수는 여기가 아니다 ──
# Vite 는 frontend/.env 만 읽는다. 항목과 설명은 frontend/.env.example 참고:
#   VITE_API_MODE=mock|real   가짜 서버(MSW) / 실서버 전환
#   VITE_API_BASE_URL         백엔드 주소 (기본 http://localhost:8080)
#   VITE_KAKAO_JS_KEY         카카오맵 JS 키 (도메인 제한 필수. REST 키를 넣지 않는다)
#   cd frontend && cp .env.example .env
#
# ⚠️ VITE_ 로 시작하는 값은 전부 브라우저에 그대로 노출된다. 비밀을 넣지 않는다.

# ── 웹메일 인증 코드 발송 (임승현 T1-2, domain/auth.yml 의 spring.mail.*) ──
# Gmail 이면 MAIL_USERNAME 은 주소, MAIL_PASSWORD 는 "앱 비밀번호"(2단계 인증 필요). 계정 비밀번호가 아니다.
# local 프로파일은 코드를 로그에도 찍으므로 비워 두면 메일 없이 개발할 수 있다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── 베타 배포 (docker-compose.prod.yml, docs/deploy.md) ── 로컬 개발에서는 쓰지 않는다
# 프론트·API 를 함께 서빙할 도메인. A 레코드가 서버를 가리켜야 Caddy 가 인증서를 받는다. 비어 있으면 compose 가 거절한다
BETA_DOMAIN=
# 브라우저 출처 허용 목록(쉼표). 배포 compose 는 이 값이 비어 있으면 https://$BETA_DOMAIN 하나로 채운다.
# ⚠️ 셸에 이 변수를 빈 값으로 export 하면 로컬 bootRun 이 모든 출처를 거절한다 — 로컬에서는 줄을 지우거나 export 하지 않는다
# GACHIGA_CORS_ALLOWED_ORIGINS=https://beta.example.com,http://localhost:5173
# 운영 DB 커넥션 풀 크기 (기본 20)
DB_POOL_SIZE=20

# ── 담당자가 추가할 항목 ──
# JWT 시크릿(JWT_SECRET)은 임승현이 T1-4 에서 추가한다. 항목 추가는 자유지만 값은 반드시 placeholder 로 둔다.
