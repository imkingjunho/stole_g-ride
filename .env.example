# ─────────────────────────────────────────────────────────────
# 가치가(WE-Meet) 환경변수 예시 파일
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# ⚠️ .env 는 절대 커밋하지 않는다 (.gitignore 에 등록돼 있음).
# ⚠️ 이 파일에는 실제 키 값을 적지 않는다. placeholder 만 둔다.
#    실제 키는 팀 단톡방이 아니라 별도 채널로 받는다. (PRD §13.7)
#
# 아래 DB/Redis 기본값은 docker-compose.yml 및
# backend/src/main/resources/application-local.yml 의 기본값과 같다.
# 그대로 두면 .env 없이도 로컬 개발이 된다.
#
# ⚠️ .env 를 읽는 것은 docker compose 뿐이다. ./gradlew bootRun 은 읽지 않는다.
#    DB_* / REDIS_* 값을 바꾸면 컨테이너만 바뀌고 백엔드는 기본값으로 붙어 연결이 깨진다.
#    바꿔야 한다면 같은 값을 셸에도 export 하거나 application-local.yml 을 함께 고친다.
# ─────────────────────────────────────────────────────────────

# ── MySQL (로컬 개발 전용 값. 운영 비밀번호를 여기에 적지 않는다) ──
# 'localhost' 가 아니라 127.0.0.1 이다 — macOS 에서 localhost 는 IPv6(::1) 로 먼저 해석되는데
# 컨테이너는 IPv4 127.0.0.1 에만 열려 있어 연결이 실패한다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gachiga
DB_USERNAME=gachiga
DB_PASSWORD=gachiga
# 컨테이너 root 비밀번호. 로컬 전용이며 애플리케이션은 사용하지 않는다
MYSQL_ROOT_PASSWORD=root

# ── Redis ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 로컬 Redis 는 비밀번호 없이 뜬다. 운영 프로파일에서는 필수 항목이다
REDIS_PASSWORD=

# ── 카카오 (백엔드 전용. 프론트 코드에 절대 노출 금지 — CLAUDE.md §8) ──
# 카카오모빌리티 길찾기 / 로컬 API 호출용 REST 키
KAKAO_REST_API_KEY=여기에-발급받은-REST-키를-넣으세요
# 카카오맵 JS SDK 용 JavaScript 키 (프론트에서 사용, 도메인 제한 필수)
KAKAO_JS_KEY=여기에-발급받은-JavaScript-키를-넣으세요

# ── 담당자가 추가할 항목 ──
# 인증(JWT 시크릿, 웹메일 발송 계정) 은 임승현이 T2-1·T2-2 에서 추가한다.
# 항목 추가는 자유지만 값은 반드시 placeholder 로 둔다.
